# Ralph runtime configuration
# Copy to .env and adjust values as needed.

# Claude runner
# Allowed values: claude-opus-4-6, claude-sonnet-4-5, claude-haiku-4-5
RALPH_CLAUDE_MODEL=claude-haiku-4-5
# Allowed values: low, medium, high
RALPH_CLAUDE_REASONING_EFFORT=medium

# Codex runner
# Allowed value: gpt-5-2-codex
RALPH_CODEX_MODEL=gpt-5-2-codex
RALPH_CODEX_REASONING_EFFORT=medium

# Codex pricing in USD per 1M tokens (gpt-5.2-codex defaults)
RALPH_CODEX_INPUT_COST_PER_MILLION=1.75
RALPH_CODEX_CACHED_INPUT_COST_PER_MILLION=0.175
RALPH_CODEX_OUTPUT_COST_PER_MILLION=14

# Kimi runner
RALPH_KIMI_MODEL=kimi-code/kimi-for-coding
# Allowed values: true, false
RALPH_KIMI_THINKING=true
RALPH_KIMI_MAX_STEPS_PER_TURN=50
